<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <RollForward>Major</RollForward>
        <PublishReadyToRun>false</PublishReadyToRun>
        <TieredCompilation>false</TieredCompilation>
        <UseWindowsForms>true</UseWindowsForms>
        <EnableWindowsTargeting>true</EnableWindowsTargeting>
    </PropertyGroup>
    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Icon.ico</ApplicationIcon>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="MonoGame.Framework.WindowsDX" Version="3.8.5"/>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Xitira.GamePadTester\Xitira.GamePadTester.csproj" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="../Xitira.GamePadTester.Content/ContentDX/Content.db">
        </EmbeddedResource>
    </ItemGroup>
</Project>